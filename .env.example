# Discord Application (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_client_id
BOT_OWNER_ID=your_discord_user_id

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://globalban:globalban@localhost:5432/globalbanbot?schema=public

# Express API (Dashboard-Vorbereitung)
API_PORT=3000
API_PREFIX=/api/v1
API_KEY=generate_a_long_random_secret

# Parallelität für globale Ban-/Unban-Aktionen über Guilds
BAN_CONCURRENCY=5
