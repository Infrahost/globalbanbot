{
  "name": "globalbanbot",
  "version": "1.0.0",
  "description": "Skalierbares Discord Global-Ban-Netzwerk mit Express-API",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
